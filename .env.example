# =============================================================================
# Espaço Prelúdio — backend env vars
# Cole no Railway (Settings → Variables) do serviço osl-video-server-staging.
# =============================================================================

# ─── 1. RUNTIME (defaults OK) ────────────────────────────────────────────────
NODE_ENV=production
APP_ENV=staging                                 # ou "production" pra prod
PORT=3000                                       # Railway injeta automaticamente
FRONTEND_BASE_URL=https://staging.espacopreludio.com
THERAPY_FRONTEND_BASE=https://staging.espacopreludio.com

# ─── 2. OBRIGATÓRIO ─ Firebase Admin SDK ─────────────────────────────────────
# Service account JSON do projeto Firebase (Console → Project Settings →
# Service accounts → Generate new private key). Cole o conteúdo inteiro como
# uma linha JSON (escape \n nas chaves se precisar).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"sextolugar-staging",...}

# ─── 3. OBRIGATÓRIO ─ LiveKit (vídeo da sessão) ──────────────────────────────
# Crie projeto em cloud.livekit.io, pegue API key + secret + WS URL.
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LIVEKIT_URL=wss://osextolugar-eqa7q1iz.livekit.cloud

# ─── 4. OBRIGATÓRIO ─ Segredos (já gerados, cole tal qual) ────────────────────
ACCESS_TOKEN_SECRET=GERE_UM_SEGREDO_FORTE_E_UNICO
LICENSE_SECRET=GERE_UM_SEGREDO_FORTE_E_UNICO
ADMIN_SECRET=GERE_UM_SEGREDO_FORTE_E_UNICO
THERAPY_ADMIN_EMAILS=luishenriquekirsch@hotmail.com

# ─── 5. E-mails transacionais (Resend) ───────────────────────────────────────
# Crie conta em resend.com, verifique domínio espacopreludio.com (SPF+DKIM),
# pegue API key. Sem isso: e-mails (reset senha, lembretes, NPS, aniversários)
# ficam silenciosos.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Espaço Prelúdio <nao-responda@espacopreludio.com>

# ─── 6. Mercado Pago (cobrança dos planos) ────────────────────────────────────
# DUAS contas MP separadas: uma pro Prelúdio Jogos (one-shot), outra pro
# Espaço Prelúdio (assinaturas). Cada uma é uma aplicação distinta em
# mercadopago.com.br/developers/panel/app.
#
# JOGO: app antiga, pagamento pontual do jogo
#   Webhook (Prelúdio Jogos): BACKEND/webhooks/mercadopago
#   Eventos: payment
MP_ACCESS_TOKEN_JOGO=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MP_WEBHOOK_SECRET_JOGO=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# THERAPY: app dedicada ao Espaço Prelúdio (assinaturas mensais)
#   Webhook (Espaço Prelúdio): BACKEND/therapy/webhook/mp
#   Eventos: preapproval, subscription_preapproval
MP_ACCESS_TOKEN_THERAPY=APP_USR-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
MP_WEBHOOK_SECRET_THERAPY=zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz
#
MP_WEBHOOK_REQUIRE_SIG=true
#
# Legados (fallback): se MP_ACCESS_TOKEN_JOGO/THERAPY não estiverem setados,
# o backend cai pra MP_ACCESS_TOKEN/MP_WEBHOOK_SECRET genéricos.  Mantido
# pra não quebrar deploys antigos durante a migração.
# MP_ACCESS_TOKEN=...
# MP_WEBHOOK_SECRET=...

# ─── 7. Web Push (notificações) ──────────────────────────────────────────────
# Já gerei VAPID keys prontas — cole tal qual no Railway.
VAPID_PUBLIC_KEY=xxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxx
VAPID_SUBJECT=mailto:contato@espacopreludio.com.br

# ─── 8. Anthropic (validação de comprovante de estudante via Claude Vision) ─
# console.anthropic.com → API keys. Sem isso, validação automática vira
# manual (admin precisa aprovar à mão cada estudante).
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── 9. S3 / R2 (uploads de comprovantes + recibos) ──────────────────────────
# Pode ser AWS S3 OU Cloudflare R2 (mais barato). R2 endpoint:
# https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxx
S3_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
S3_BUCKET=espacopreludio-uploads
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_PUBLIC_URL=https://uploads.espacopreludio.com

# ─── 10. WhatsApp via Z-API (opcional, lembretes WhatsApp) ───────────────────
# z-api.io → instâncias → criar nova → conectar WhatsApp → copiar tokens.
ZAPI_INSTANCE_ID=3X00X0X00X0X0X0X
ZAPI_CLIENT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZAPI_SECURITY_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZAPI_BASE_URL=https://api.z-api.io

# ─── 11. Validador de CFP (opcional, valida CRP automaticamente) ─────────────
# Provider: "idwall" ou "confiradoc" ou "manual" (default).
CFP_VALIDATOR_PROVIDER=manual
IDWALL_API_KEY=
CONFIRADOC_API_KEY=

# ─── 12. NFS-e via NFe.io (opcional, emissão de nota fiscal) ─────────────────
# nfe.io → API tokens. Sem isso, emissão NFS-e fica desabilitada.
# (Vars carregadas no services/nfse-nfeio.js, conferir nomes lá.)

# ─── 13. Asaas (opcional, gateway alternativo) ───────────────────────────────
ASAAS_WEBHOOK_TOKEN=

# ─── 14. Reminder lookahead (default 24h) ────────────────────────────────────
REMINDER_LOOKAHEAD_HOURS=24
THERAPY_MIN_CANCEL_HOURS_PATIENT=12
THERAPY_TRIAL_DAYS=14
THERAPY_TRIAL_DAYS_PROFISSIONAL=14
THERAPY_TRIAL_DAYS_RECEM_FORMADO=30
THERAPY_PLAN_AMOUNT=199.00
THERAPY_PLAN_PROFISSIONAL_AMOUNT=199.00
THERAPY_PLAN_RECEM_FORMADO_AMOUNT=99.50
