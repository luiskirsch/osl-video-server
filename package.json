{
  "name": "osl-video-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend do O SextoLugar - pagamentos, licenças, Discord e LiveKit",
  "main": "server.js",
  "type": "commonjs",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "22.x || 24.x",
    "npm": ">=10.9"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15",
    "adm-zip": "^0.6.1",
    "body-parser": "^1.20.8",
    "ip-address": "^10.2.0",
    "qs": "^6.16.0",
    "sharp": "^0.35.4",
    "uuid": "^11.1.1"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "node scripts/check-syntax.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "npm run lint && npm test",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "@huggingface/transformers": "^4.3.0",
    "@sentry/node": "^10.75.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.4.0",
    "geoip-country": "^5.0.202609160137",
    "helmet": "^8.3.0",
    "livekit-server-sdk": "^2.19.0",
    "morgan": "^1.12.1",
    "node-forge": "^1.4.0",
    "socket.io": "^4.8.3",
    "stripe": "^22.6.2",
    "wavefile": "^11.0.0",
    "web-push": "^3.6.7",
    "xml-crypto": "^6.2.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0"
  }
}
